---
import Mark from './Mark.astro';
import { visiProducts } from '../products';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-900 py-12">
  <div class="container-wide flex flex-col md:flex-row gap-6 md:items-center justify-between text-sm text-ink-500">
    <div class="flex items-center gap-2.5">
      <Mark class="w-5 h-5 text-ink-400" />
      <span>VisiPass · © {year} VisiOffice · AGPL-3.0</span>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
      <a class="hover:text-white" href="https://github.com/VisiOffice/VisiPass">GitHub</a>
      <a class="hover:text-white" href="https://github.com/VisiOffice/VisiPass/releases">Releases</a>
      <a class="hover:text-white" href="https://github.com/VisiOffice/VisiPass/blob/main/docs/crypto-design.md">Security design</a>
      <a class="hover:text-white" href="https://github.com/VisiOffice/VisiPass/blob/main/skills/visipass/SKILL.md">Agent skill</a>
      <a class="hover:text-white" href="https://github.com/VisiOffice/VisiPass/issues">Issues</a>
      <a class="hover:text-white" href="/privacy">Privacy</a>
    </nav>
  </div>
  <div class="container-wide mt-8 pt-6 border-t border-ink-900 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-500">
    <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink-600">ALSO FROM VISIOFFICE</span>
    {visiProducts.map((p) => <a class="hover:text-white" href={p.url}>{p.name}</a>)}
  </div>
</footer>
