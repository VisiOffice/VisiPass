---
import Mark from './Mark.astro';
import { visiProducts } from '../products';

const links = [
  { href: '/#how', label: 'How it works' },
  { href: '/#browser', label: 'Browser' },
  { href: '/#vault', label: 'Vault' },
  { href: '/#install', label: 'Install' },
];
---

<header class="fixed top-0 inset-x-0 z-40 border-b border-ink-800/60 bg-ink-950/70 backdrop-blur-md">
  <nav class="container-wide h-14 flex items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5 text-white font-semibold">
      <Mark class="w-6 h-6 text-white" />
      VisiPass
    </a>
    <div class="hidden md:flex items-center gap-7 text-sm text-ink-400">
      {links.map((l) => <a href={l.href} class="hover:text-white transition-colors">{l.label}</a>)}
    </div>
    <div class="flex items-center gap-3">
      <details class="product-switcher relative">
        <summary class="flex items-center gap-1 text-sm text-ink-400 hover:text-white transition-colors cursor-pointer select-none list-none">
          <span class="hidden sm:inline">Explore VisiOffice</span><span class="sm:hidden">VisiOffice</span>
          <svg class="chev w-3.5 h-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            ><path d="m6 9 6 6 6-6"></path></svg
          >
        </summary>
        <div
          class="absolute right-0 mt-3 w-[min(19rem,calc(100vw-2rem))] rounded-xl border border-ink-800 bg-ink-950/95 backdrop-blur-md p-2 shadow-2xl shadow-black/60"
        >
          <p class="px-3 pt-2 pb-1.5 font-mono text-[10.5px] tracking-[0.16em] text-ink-500">THE VISIOFFICE SUITE</p>
          {
            visiProducts.map((p) => (
              <a href={p.url} class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 hover:bg-ink-900 group">
                <span>
                  <span class="block text-sm font-medium text-white">{p.name}</span>
                  <span class="block text-xs text-ink-500">{p.description}</span>
                </span>
                <span class="text-ink-600 group-hover:text-tn-accent" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </details>
      <a
        href="https://github.com/VisiOffice/VisiPass"
        class="text-ink-400 hover:text-white transition-colors"
        aria-label="VisiPass on GitHub"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
      <a href="/#install" class="btn btn-primary text-sm px-3.5 py-1.5">Install</a>
    </div>
  </nav>
</header>

<style>
  .product-switcher summary::-webkit-details-marker {
    display: none;
  }
  .product-switcher[open] .chev {
    transform: rotate(180deg);
  }
</style>

<script>
  // Close the product menu on an outside click or Escape, as the other Visi sites do.
  const menu = document.querySelector<HTMLDetailsElement>('.product-switcher')!;
  document.addEventListener('click', (e) => {
    if (e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
