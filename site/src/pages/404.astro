---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Mark from '../components/Mark.astro';
---

<BaseLayout title="Not found — VisiPass">
  <Nav />
  <main class="min-h-[70vh] grid place-items-center px-4 pt-14">
    <div class="text-center">
      <Mark class="w-12 h-12 mx-auto text-ink-700" />
      <h1 class="mt-6 text-3xl font-bold text-white">Nothing behind this door.</h1>
      <p class="mt-3 text-ink-400">That page doesn’t exist.</p>
      <a href="/" class="btn btn-secondary mt-8">Back to VisiPass</a>
    </div>
  </main>
</BaseLayout>
