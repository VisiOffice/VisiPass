{
  "manifest_version": 3,
  "name": "VisiPass",
  "version": "0.5.0",
  "description": "Fill logins from VisiPass. Fills only on the login's own site, after you approve each site once.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inline.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VisiPass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/visipass-16.png",
      "32": "icons/visipass-32.png",
      "48": "icons/visipass-48.png"
    }
  },
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Fill the best login for this page"
    }
  },
  "icons": {
    "16": "icons/visipass-16.png",
    "32": "icons/visipass-32.png",
    "48": "icons/visipass-48.png",
    "128": "icons/visipass-128.png"
  }
}
